<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Acción para abrir la lista de propiedades -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">estate.property</field>
    <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p>
                Haga clic en un registro para ver los detalles.
            </p>
        </field>
    </record>

    <record id="list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties"
              decoration-success="offer_received_bool"
              decoration-bf="offer_accepted_bool"
              decoration-info="sold_bool">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="show"/>
                <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para una propiedad -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Propiedad">
                <sheet>
                    <header>
                        <button name="action_cancel"
                                type="object"
                                string="Cancel"
                                invisible="state != 'new'"/>

                        <button name="action_mark_sold"
                                type="object"
                                string="Sold"
                                invisible="state not in ('new', 'offer_accepted')"/>
                    </header>

                    <field name="state" widget="statusbar" 
                           statusbar_visible="new,offer_received,offer_accepted,sold,canceled"
                           nolabel="1" class="o_statusbar_full_width"/>
                    <style>.o_statusbar_full_width {display: flex; justify-content: flex-end;}</style>

                    <group>
                        <field name="name" class="oe_title" nolabel="1" style="font-size:50px; font-weight:bold;"/>
                    </group>

                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>

                    <!-- Datos principales de la propiedad -->
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="postcode"/>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer" readonly="1"/>
                            <field name="selling_price"/>
                        </group>
                    </group>

                    <!-- Pestañas con información adicional -->
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area" readonly="1"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <!-- Lista y formulario de ofertas asociadas a la propiedad -->
                            <field name="offer_ids" 
                                   readonly="state in ('offer_accepted','sold','canceled')">
                                <list editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <button name="action_accept"
                                            type="object"
                                            icon="fa-check"
                                            class="btn-success"
                                            invisible="status in ('accepted','refused')"/>
                                    <button name="action_refuse"
                                            type="object"
                                            icon="fa-times"
                                            class="btn-danger"
                                            invisible="status in ('accepted','refused')"/>
                                    <field name="status"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <button name="action_accept"
                                                type="object"
                                                string="Aceptar"
                                                class="btn-success"
                                                invisible="status in ('accepted','refused')"/>
                                        <button name="action_refuse"
                                                type="object"
                                                string="Rechazar"
                                                class="btn-danger"
                                                invisible="status in ('accepted','refused')"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="seller_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda y filtros para propiedades -->
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <field name="property_type_id" filter_domain="[('property_type_id','=',self)]"/>
                <filter name="available"
                        string="Propiedades disponibles"
                        domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <group expand="1" string="Agrupar por">
                    <filter name="group_by_postcode"
                            string="Código Postal"
                            context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>